# Transit provider selection: "hsl" (default) or "vietnam"
VITE_TRANSIT_PROVIDER=hsl

# --- HSL (Helsinki) provider ---
# Digitransit API key - required for route polylines and route search
# Register at https://portal-api.digitransit.fi/ to get your key
# The MQTT vehicle positions API does not require authentication
VITE_DIGITRANSIT_API_KEY=your_api_key_here

# --- Vietnam provider ---
# Base URL for the Vietnam transit REST API (leave empty to disable route/stop fetching)
VITE_VIETNAM_API_BASE=
# Optional API key for the Vietnam transit API
VITE_VIETNAM_API_KEY=
# MQTT broker for live vehicle positions (leave empty to run without live tracking)
VITE_VIETNAM_MQTT_BROKER=
# MQTT topic prefix for vehicle position messages
VITE_VIETNAM_MQTT_TOPIC_PREFIX=/hfp/v2/journey/ongoing/vp
# Prefix applied to route GTFS IDs (e.g. "VN:")
VITE_VIETNAM_ROUTE_ID_PREFIX=VN:
# MQTT direction offset (GTFS 0/1 -> MQTT 1/2 => offset 1)
VITE_VIETNAM_MQTT_DIR_OFFSET=1
# IANA timezone for service-day/date formatting
VITE_VIETNAM_TIMEZONE=Asia/Ho_Chi_Minh
