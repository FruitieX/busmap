# Transit provider selection: "hsl" (default) or "vietnam"
VITE_TRANSIT_PROVIDER=hsl

# --- HSL (Helsinki) provider ---
# Digitransit API key - required for route polylines and route search
# Register at https://portal-api.digitransit.fi/ to get your key
# The MQTT vehicle positions API does not require authentication
VITE_DIGITRANSIT_API_KEY=your_api_key_here

# --- Vietnam provider (timbus.vn - Hanoi public bus data) ---
# Base URL for timbus.vn (uses HTTP, no authentication required)
VITE_VIETNAM_API_BASE=http://timbus.vn
# Prefix applied to route GTFS IDs (e.g. "TB:" for timbus.vn)
VITE_VIETNAM_ROUTE_ID_PREFIX=TB:
# IANA timezone for service-day/date formatting
VITE_VIETNAM_TIMEZONE=Asia/Ho_Chi_Minh

# timbus.vn is static-only (no live vehicle GPS feed), so MQTT broker is not used.
# Leave VITE_VIETNAM_MQTT_BROKER empty.
