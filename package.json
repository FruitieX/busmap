{
  "name": "busmap",
  "version": "3.9.0",
  "description": "Real-time public transport vehicle tracker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "ci:build": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run build && npm run ci:verify-build",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "ci:smoke": "npm run test:e2e",
    "ci:deploy": "npm run ci:build && npm run test:unit && node scripts/wait-for-ci.mjs",
    "ci:verify-build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "maplibre-gl": "6.16.0",
    "motion": "14.9.0",
    "mqtt": "5.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0"
  }
}
