{
  "name": "busmap",
  "version": "3.9.0",
  "description": "Real-time public transport vehicle tracker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "ci:build": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run build && npm run ci:verify-build",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "ci:smoke": "npm run test:e2e",
    "ci:deploy": "npm run ci:build && npm run test:unit && node scripts/wait-for-ci.mjs",
    "ci:verify-build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "motion": "14.6.0",
    "maplibre-gl": "6.16.0",
    "mqtt": "5.16.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "8.1.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "@playwright/test": "1.64.1",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0"
  }
}
